# ============================================================================
# MCP_Enhancement Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control
# ============================================================================

# --- General Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
WATCHDOG_POLLING_INTERVAL=3600

# --- OpenAI / LLM Configuration ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Jira Configuration ---
# URL: Your Jira instance URL (e.g., https://company.atlassian.net)
# EMAIL: Your Jira account email
# API_TOKEN: Generate from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=ATATT3xxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT_KEY=


# --- GitHub Configuration ---
# TOKEN: Personal Access Token from https://github.com/settings/tokens
#        Required scopes: repo, read:user, workflow
# REPOSITORY: Format as owner/repo (e.g., openMF/fineract)
# WEBHOOK_SECRET: Secret for verifying GitHub webhook signatures (optional but recommended)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPOSITORY=
GITHUB_WEBHOOK_SECRET=your-webhook-secret-xyz

# --- Slack Configuration ---
# BOT_TOKEN: Bot User OAuth Token from https://api.slack.com/apps
#            Should start with xoxb-
# SIGNING_SECRET: Found in Slack App "Basic Information" tab
# REPORT_CHANNEL_ID: Channel ID for intelligence reports (get from right-click channel > details)
# ALERT_CHANNEL_ID: Channel ID for instant PR and CI alerts
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_REPORT_CHANNEL_ID=C1234567890
SLACK_ALERT_CHANNEL_ID=C0987654321
AUTHORIZED_USERS=User ids of Those who are authorized to post github comments and create jira tickets

# --- Pinecone Vector Database Configuration ---
# API_KEY: Get from https://app.pinecone.io
# INDEX_NAME: Name of the Pinecone index (will be auto-created if missing)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=mifos-knowledge-base

# --- FINERACT BANKING CONFIG ---
FINERACT_BASE_URL=
FINERACT_TENANT_ID=
FINERACT_USERNAME=
FINERACT_PASSWORD=